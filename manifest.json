{
  "runtime": "trusted-native-canvas-v1",
  "name": "Taskbar Accent",
  "version": "2.0.0",
  "entry": "dist/index.html",
  "settingsVersion": "2",
  "homepage": "https://github.com/MyWallpapers/mywallpaper-addon-taskbar-accent",
  "repository": "https://github.com/MyWallpapers/mywallpaper-addon-taskbar-accent",
  "settings": {
    "enabled": {
      "type": "boolean",
      "label": "Enable taskbar accent",
      "scope": "addon",
      "default": true
    },
    "mode": {
      "type": "select",
      "label": "Taskbar mode",
      "scope": "addon",
      "default": "blur",
      "options": [
        { "label": "Blur", "value": "blur" },
        { "label": "Acrylic blur", "value": "acrylic" },
        { "label": "Transparent", "value": "transparent" },
        { "label": "Accent color", "value": "accent" }
      ]
    },
    "accentColor": {
      "type": "color",
      "label": "Accent color",
      "scope": "addon",
      "default": "#1f8fff"
    },
    "opacity": {
      "type": "range",
      "label": "Opacity",
      "scope": "addon",
      "default": 128,
      "min": 0,
      "max": 255,
      "step": 1
    }
  },
  "defaultLayout": {
    "widthPercent": 22,
    "heightPercent": 8,
    "xPercent": 39,
    "yPercent": 84,
    "rotation": 0
  },
  "native": {
    "hooks": [
      {
        "id": "taskbar",
        "runtime": "windhawk-v1",
        "source": "native/hooks/taskbar.wh.cpp",
        "surface": "windows-shell-v1"
      }
    ]
  },
  "ui": {
    "pointerEvents": "none"
  }
}
