{
  "name": "Taskbar Accent",
  "version": "1.1.0",
  "runtime": "trusted-native-canvas-v1",
  "entry": "dist/index.html",
  "native": {
    "runtime": "windhawk-native-v1",
    "entry": "native/mod.wh.cpp"
  },
  "description": "Applies a live blur, transparent, or color accent to the Windows taskbar.",
  "author": "MyWallpaper Team",
  "type": "addon",
  "categories": ["utilities", "desktop"],
  "license": "GPL-3.0-or-later",
  "repository": "https://github.com/MyWallpapers/mywallpaper-addon-taskbar-accent",
  "defaultLayout": {
    "widthPercent": 22,
    "heightPercent": 8,
    "xPercent": 39,
    "yPercent": 84,
    "rotation": 0
  },
  "ui": {
    "pointerEvents": "none"
  },
  "settings": {
    "enabled": {
      "type": "boolean",
      "content": {
        "label": "Enable taskbar accent",
        "default": true
      }
    },
    "mode": {
      "type": "select",
      "content": {
        "label": "Taskbar mode",
        "default": "blur",
        "options": [
          {
            "label": "Blur",
            "value": "blur"
          },
          {
            "label": "Acrylic blur",
            "value": "acrylic"
          },
          {
            "label": "Transparent",
            "value": "transparent"
          },
          {
            "label": "Accent color",
            "value": "accent"
          }
        ]
      }
    },
    "accentColor": {
      "type": "color",
      "content": {
        "label": "Accent color",
        "default": "#1f8fff"
      }
    },
    "opacity": {
      "type": "range",
      "content": {
        "label": "Opacity",
        "default": 128,
        "min": 0,
        "max": 255,
        "step": 1
      }
    }
  }
}
