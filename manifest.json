{
  "runtime": "canvas-v1",
  "name": "Taskbar Accent",
  "description": "Applies a configurable Windows composition effect to every taskbar through the official MyWallpaper native runtime.",
  "version": "3.0.0",
  "entry": "dist/index.html",
  "thumbnail": "assets/thumbnail.png",
  "deviceSettingsVersion": "1",
  "ui": {
    "pointerEvents": "none"
  },
  "settings": [
    {
      "id": "enabled",
      "type": "boolean",
      "label": "Enable taskbar accent",
      "description": "Controls every Taskbar Accent instance on this device.",
      "scope": "device",
      "default": true
    },
    {
      "id": "mode",
      "type": "select",
      "label": "Taskbar mode",
      "scope": "device",
      "default": "blur",
      "options": [
        { "label": "Blur", "value": "blur" },
        { "label": "Acrylic blur", "value": "acrylic" },
        { "label": "Transparent", "value": "transparent" },
        { "label": "Accent color", "value": "accent" }
      ]
    },
    {
      "id": "accentColor",
      "type": "color",
      "label": "Accent color",
      "scope": "device",
      "default": "#1f8fff"
    },
    {
      "id": "opacity",
      "type": "range",
      "label": "Opacity",
      "scope": "device",
      "default": 128,
      "min": 0,
      "max": 255,
      "step": 1
    }
  ],
  "native": {
    "hooks": [
      {
        "id": "taskbar",
        "runtime": "windhawk-v1",
        "source": "native/hooks/taskbar.wh.cpp",
        "surface": "windows-shell-v1"
      }
    ]
  }
}
